/* ======================================================
MODULE 01
INITIALISATION SERVEUR LICENCE VPIJLR
====================================================== */

const express = require("express")
const fs = require("fs")
const app = express()

app.use(express.json())

const fichierLicences = "./licences.json"


/* ======================================================
MODULE 02
GENERATEUR CODE LICENCE
7 BLOCS DE 6 CARACTERES
====================================================== */

function genererLicence(){

const caracteres="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

let code=""

for(let bloc=0;bloc<7;bloc++){

let segment=""

for(let i=0;i<6;i++){
segment+=caracteres.charAt(Math.floor(Math.random()*caracteres.length))
}

code+=segment

if(bloc<6){
code+="-"
}

}

return code

}


/* ======================================================
MODULE 03
LECTURE DES LICENCES
====================================================== */

function lireLicences(){

if(!fs.existsSync(fichierLicences)){
return []
}

return JSON.parse(fs.readFileSync(fichierLicences))

}


/* ======================================================
MODULE 04
SAUVEGARDE LICENCE
====================================================== */

function sauvegarderLicence(licence){

let licences=lireLicences()

licences.push(licence)

fs.writeFileSync(
fichierLicences,
JSON.stringify(licences,null,2)
)

}


/* ======================================================
MODULE 05
PAIEMENT CONFIRME
GENERATION LICENCE
====================================================== */

app.post("/paiement-confirme",(req,res)=>{

const client=req.body.client
const email=req.body.email
const type=req.body.type

const codeLicence=genererLicence()

const aujourd=new Date()

let expiration=new Date(aujourd)

if(type==="mensuelle"){
expiration.setMonth(expiration.getMonth()+1)
}

if(type==="annuelle"){
expiration.setFullYear(expiration.getFullYear()+1)
}

const licence={

logiciel:"VPIJLR 2026",

client:client,

email:email,

licence:codeLicence,

type:type,

date_activation:aujourd.toISOString().split("T")[0],

date_expiration:expiration.toISOString().split("T")[0]

}

sauvegarderLicence(licence)

res.json({

status:"ok",

licence:licence

})

})


/* ======================================================
MODULE 06
VERIFICATION LICENCE
UTILISE PAR LE LOGICIEL
====================================================== */

app.post("/verifier-licence",(req,res)=>{

const code=req.body.licence

const licences=lireLicences()

const licence=licences.find(l=>l.licence===code)

if(!licence){

return res.json({
valide:false
})

}

const aujourd=new Date()

const expiration=new Date(licence.date_expiration)

if(aujourd>expiration){

return res.json({
valide:false,
raison:"expiree"
})

}

res.json({
valide:true,
licence:licence
})

})


/* ======================================================
MODULE 07
RECUPERER LICENCE
====================================================== */

app.get("/licence/:code",(req,res)=>{

const code=req.params.code

const licences=lireLicences()

const licence=licences.find(l=>l.licence===code)

if(!licence){

return res.status(404).send("Licence introuvable")

}

res.json(licence)

})


/* ======================================================
MODULE 08
TELECHARGEMENT LICENCE.JSON
====================================================== */

app.get("/telecharger-licence/:code",(req,res)=>{

const code=req.params.code

const licences=lireLicences()

const licence=licences.find(l=>l.licence===code)

if(!licence){

return res.status(404).send("Licence introuvable")

}

const nomFichier="licence_"+code+".json"

res.setHeader(
"Content-Disposition",
"attachment; filename="+nomFichier
)

res.json(licence)

})


/* ======================================================
MODULE 09
DEMARRAGE SERVEUR
====================================================== */

app.listen(3000,()=>{

console.log("Serveur licence VPIJLR actif sur port 3000")

})

