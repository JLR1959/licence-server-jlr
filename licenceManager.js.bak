/* ======================================================
MODULE 01
BASE DES LICENCES
====================================================== */

let licences = []

/* ======================================================
MODULE 02
GENERATEUR CODE ACTIVATION
42 CARACTERES (7 BLOCS x 6 CARACTERES)
====================================================== */

function genererCodeActivation(){

  const caracteres = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
  let code = ""

  for(let bloc = 0; bloc < 7; bloc++){

    let segment = ""

    for(let i = 0; i < 6; i++){

      segment += caracteres.charAt(
        Math.floor(Math.random() * caracteres.length)
      )

    }

    code += segment

    if(bloc < 6) code += "-"

  }

  return code

}

/* ======================================================
MODULE 03
CALCULER DATES LICENCE
====================================================== */

function calculerDatesLicence(){

  const type = document.getElementById("typeLicence").value
  const aujourd = new Date()

  let renouvellement = new Date(aujourd)

  if(type === "mensuelle" || type === "mensuelle_multi"){
    renouvellement.setMonth(renouvellement.getMonth() + 1)
  }

  if(type === "annuelle" || type === "annuelle_multi"){
    renouvellement.setFullYear(renouvellement.getFullYear() + 1)
  }

  document.getElementById("dateActivation").value =
    aujourd.toISOString().split("T")[0]

  document.getElementById("dateRenouvellement").value =
    renouvellement.toISOString().split("T")[0]

}

/* ======================================================
MODULE 04
CREATION LICENCE
====================================================== */

function genererLicence(){

  const logiciel = document.getElementById("logiciel").value
  const client = document.getElementById("client").value
  const renouvellement = document.getElementById("dateRenouvellement").value

  if(client === ""){

    alert("Entrer le nom du client")
    return

  }

  const code = genererCodeActivation()

  document.getElementById("licenceGeneree").value = code

  const licence = {

    logiciel: logiciel,
    client: client,
    renouvellement: renouvellement,
    cle: code,
    statut: "actif"

  }

  licences.push(licence)

  sauvegarderLicences()

  afficherLicences()

  afficherAlerteExpiration()

}

/* ======================================================
MODULE 05
AFFICHAGE LICENCES
====================================================== */

function afficherLicences(){

  const table = document.getElementById("listeClients")

  table.innerHTML = ""

  const aujourd = new Date()

  licences.forEach((licence, index) => {

    const renouvellement = new Date(licence.renouvellement)

    const diffTemps = renouvellement - aujourd

    const diffJours =
      Math.ceil(diffTemps / (1000 * 60 * 60 * 24))

    let statut = licence.statut

    if(diffJours <= 0){

      statut = "expirée"

    }

    if(diffJours > 0 && diffJours <= 30){

      statut = `expire bientôt (${diffJours} jours)`

    }

    const ligne = document.createElement("tr")

    ligne.innerHTML = `

      <td>${licence.logiciel}</td>
      <td>${licence.client}</td>
      <td>${licence.renouvellement}</td>
      <td>${statut}</td>

      <td>

        <button onclick="copierLicence(${index})">
        Copier
        </button>

        <button onclick="supprimerLicence(${index})">
        Supprimer
        </button>

      </td>

    `

    table.appendChild(ligne)

  })

}

/* ======================================================
MODULE 06
COPIER LICENCE
====================================================== */

function copierLicence(index){

  navigator.clipboard.writeText(
    licences[index].cle
  )

}

/* ======================================================
MODULE 07
SUPPRIMER LICENCE
====================================================== */

function supprimerLicence(index){

  licences.splice(index, 1)

  sauvegarderLicences()

  afficherLicences()

  afficherAlerteExpiration()

}

/* ======================================================
MODULE 08
RECHERCHE CLIENT
====================================================== */

function rechercherClient(){

  const filtre =
    document.getElementById("rechercheClient")
    .value
    .toLowerCase()

  const lignes =
    document.querySelectorAll("#listeClients tr")

  lignes.forEach(ligne => {

    const client =
      ligne.children[1].textContent.toLowerCase()

    ligne.style.display =
      client.includes(filtre) ? "" : "none"

  })

}

/* ======================================================
MODULE 09
SAUVEGARDE LOCALSTORAGE
====================================================== */

function sauvegarderLicences(){

  localStorage.setItem(
    "licences",
    JSON.stringify(licences)
  )

}

/* ======================================================
MODULE 10
CHARGEMENT AU DEMARRAGE
====================================================== */

function chargerLicences(){

  const data = localStorage.getItem("licences")

  if(data){

    licences = JSON.parse(data)

  }

  afficherLicences()

  calculerDatesLicence()

}

/* ======================================================
MODULE 11
ALERTE EXPIRATION LICENCES
====================================================== */

function afficherAlerteExpiration(){

  const aujourd = new Date()

  let licencesExpireesBientot = 0

  licences.forEach((licence) => {

    const renouvellement =
      new Date(licence.renouvellement)

    const diffTemps =
      renouvellement - aujourd

    const diffJours =
      Math.ceil(diffTemps / (1000 * 60 * 60 * 24))

    if(diffJours > 0 && diffJours <= 30){

      licencesExpireesBientot++

    }

  })

  const alerte =
    document.getElementById("alerteExpiration")

  if(licencesExpireesBientot > 0){

    alerte.style.display = "block"

    alerte.innerHTML =
      `⚠ ${licencesExpireesBientot} licence` +
      `${licencesExpireesBientot > 1 ? "s" : ""}` +
      ` expirent dans les 30 prochains jours.`

  }

  else{

    alerte.style.display = "none"

  }

}

/* ======================================================
MODULE 12
DEMARRAGE APPLICATION
====================================================== */

window.onload = function(){

  chargerLicences()

  afficherAlerteExpiration()

}
